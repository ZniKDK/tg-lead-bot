# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# ID администраторов через запятую — обязательно (узнать свой ID: @userinfobot).
# Каждый админ должен один раз открыть бота и нажать /start, иначе Telegram не даст ему писать
ADMIN_IDS=
# Услуги через точку с запятой
SERVICES=Консультация;Диагностика;Ремонт
# Рабочее время, длина слота (мин), на сколько дней вперёд открыта запись
WORK_START=10:00
WORK_END=19:00
SLOT_MINUTES=60
DAYS_AHEAD=7
# Выходные: 0 — понедельник ... 6 — воскресенье
DAYS_OFF=6
DB_PATH=data/leads.db
